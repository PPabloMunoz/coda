---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout title="Unlinked files" current="link">
  <PageHeader
    eyebrow="Manage"
    title="Unlinked files"
    description="Files that aren’t tied to a MusicBrainz track yet. Link one by choosing its artist, release group, release, and track."
  >
    <a class="btn btn--secondary" href="/files">
      All files
    </a>
    <button class="btn btn--primary" id="refresh" type="button">
      Refresh
    </button>
  </PageHeader>

  <div class="stat-row">
    <div class="stat-card">
      <span class="stat-card__label">Unlinked</span>
      <span class="stat-card__value" id="stat-unlinked">
        —
      </span>
    </div>
    <div class="stat-card">
      <span class="stat-card__label">Linked</span>
      <span class="stat-card__value" id="stat-linked">
        —
      </span>
    </div>
    <div class="stat-card">
      <span class="stat-card__label">Formats</span>
      <span class="stat-card__value" id="stat-formats">
        —
      </span>
    </div>
  </div>

  <div class="toolbar">
    <label class="search">
      <input
        id="filter"
        name="q"
        type="search"
        placeholder="Filter by file name or folder…"
        autocomplete="off"
        aria-label="Filter unlinked files by name or folder"
      />
    </label>
    <label class="inline-field">
      <span>Format</span>
      <select id="format-filter">
        <option value="">All formats</option>
      </select>
    </label>
    <span class="toolbar__count" id="status">
      Loading files…
    </span>
  </div>

  <div class="file-list" id="list" aria-live="polite"></div>
  <div id="empty" hidden></div>

  <dialog id="wizard" class="wizard" aria-labelledby="wizard-title">
    <div class="wizard__shell">
      <header class="wizard__head">
        <div>
          <p class="eyebrow">Link file</p>
          <h2 id="wizard-title">Choose a track</h2>
        </div>
        <button
          class="icon-btn"
          id="wizard-close"
          type="button"
          aria-label="Close"
        >
          ×
        </button>
      </header>

      <div class="wizard__file">
        <div class="file-row__format" id="wizard-file-format">
          FILE
        </div>
        <div>
          <p class="wizard__file-name" id="wizard-file-name"></p>
          <p class="wizard__file-path" id="wizard-file-path"></p>
        </div>
      </div>

      <ol class="wizard__steps" id="wizard-steps">
        <li>
          <span class="wizard__stepnum">1</span>Artist
        </li>
        <li>
          <span class="wizard__stepnum">2</span>Release group
        </li>
        <li>
          <span class="wizard__stepnum">3</span>Track
        </li>
      </ol>

      <div class="wizard__trail" id="wizard-trail"></div>
      <div class="wizard__body" id="wizard-body"></div>

      <footer class="wizard__foot">
        <button class="btn btn--ghost" id="wizard-back" type="button">
          Back
        </button>
        <label
          class="wizard__move"
          title="Also move the file into its Artist / Album folder when linking"
        >
          <input id="wizard-move" type="checkbox" />
          <span>Move file</span>
        </label>
        <span class="form-status" id="wizard-status" role="status"></span>
        <button
          class="btn btn--primary"
          id="wizard-next"
          type="button"
          disabled
        >
          Continue
        </button>
      </footer>
    </div>
  </dialog>

  <script>
    import {
      api,
      creditName,
      fmtDuration,
      type Artist,
      type LocalFile,
      type LocalFilesStats,
      type Release,
      type ReleaseGroup,
      type Track,
    } from '../lib/api';
    import {
      baseName,
      dirName,
      extension,
      formatBytes,
      formatDate,
      typeLabel,
    } from '../lib/format';
    import {
      byId,
      clear,
      el,
      emptyState,
      link,
      normalize,
      pathIs,
      setFormStatus,
      artistAvatar,
      discArt,
      trackArt,
      toast,
    } from '../lib/ui';

    function formatKey(file: LocalFile): string {
      return (file.format_hint || extension(file.path)).toUpperCase();
    }

    function loading(text: string): HTMLElement {
      return el('p', 'notice', text);
    }

    function initLinkPage(): void {
      if (!pathIs('/link')) return;

      const list = byId<HTMLDivElement>('list');
      const empty = byId<HTMLDivElement>('empty');
      const status = byId<HTMLSpanElement>('status');
      const filter = byId<HTMLInputElement>('filter');
      const formatFilter = byId<HTMLSelectElement>('format-filter');
      const refresh = byId<HTMLButtonElement>('refresh');
      const statUnlinked = byId<HTMLSpanElement>('stat-unlinked');
      const statLinked = byId<HTMLSpanElement>('stat-linked');
      const statFormats = byId<HTMLSpanElement>('stat-formats');

      const dialog = byId<HTMLDialogElement>('wizard');
      const wizardFileFormat = byId<HTMLDivElement>('wizard-file-format');
      const wizardFileName = byId<HTMLParagraphElement>('wizard-file-name');
      const wizardFilePath = byId<HTMLParagraphElement>('wizard-file-path');
      const wizardSteps = byId<HTMLOListElement>('wizard-steps');
      const wizardTrail = byId<HTMLDivElement>('wizard-trail');
      const wizardBody = byId<HTMLDivElement>('wizard-body');
      const wizardStatus = byId<HTMLSpanElement>('wizard-status');
      const wizardBack = byId<HTMLButtonElement>('wizard-back');
      const wizardNext = byId<HTMLButtonElement>('wizard-next');
      const wizardMove = byId<HTMLInputElement>('wizard-move');

      type Step = 0 | 1 | 2;

      interface WizardState {
        file: LocalFile;
        step: Step;
        artist: Artist | null;
        group: ReleaseGroup | null;
        release: Release | null;
        track: Track | null;
      }

      interface PickerItem<T> {
        data: T;
        title: string;
        meta?: string;
        search?: string;
        artSeed?: string;
        artKind?: 'artist' | 'group' | 'track';
        number?: string;
      }

      let unlinkedFiles: LocalFile[] = [];
      let fileStats: LocalFilesStats | null = null;
      let artistsCache: Artist[] | null = null;
      const groupsCache = new Map<string, ReleaseGroup[]>();
      let wizardState: WizardState | null = null;
      let stepToken = 0;

      function fileRow(file: LocalFile): HTMLElement {
        const row = el('article', 'file-row');

        const format = el('div', 'file-row__format', formatKey(file));

        const main = el('div', 'file-row__main');
        main.append(
          el('h3', 'file-row__name', baseName(file.path)),
          el('p', 'file-row__path', dirName(file.path)),
        );

        const meta = el('div', 'file-row__meta');
        meta.append(
          el('span', '', formatBytes(file.size_bytes)),
          el('span', '', `Scanned ${formatDate(file.scanned_at)}`),
          el('span', 'chip chip--warn', 'Unlinked'),
        );
        main.append(meta);

        const actions = el('div', 'file-row__actions');
        actions.append(
          link(`/file?id=${file.id}`, 'Details', 'btn btn--sm btn--ghost'),
        );

        const linkButton = el(
          'button',
          'btn btn--sm btn--primary',
          'Link to track',
        );
        linkButton.type = 'button';
        linkButton.addEventListener('click', () => openWizard(file));
        actions.append(linkButton);

        row.append(format, main, actions);
        return row;
      }

      function updateStats(): void {
        const unlinked = unlinkedFiles.filter((file) => !file.track_id);
        statUnlinked.textContent = String(
          fileStats?.unlinked ?? unlinked.length,
        );
        statLinked.textContent = fileStats ? String(fileStats.linked) : '—';
        statFormats.textContent = String(
          new Set(unlinked.map((file) => formatKey(file))).size,
        );
      }

      function populateFormats(): void {
        const current = formatFilter.value;
        const formats = Array.from(
          new Set(unlinkedFiles.map(formatKey)),
        ).toSorted();

        clear(formatFilter);
        const all = new Option('All formats', '');
        formatFilter.append(all);
        for (const format of formats) {
          formatFilter.append(new Option(format, format));
        }
        formatFilter.value = formats.includes(current) ? current : '';
      }

      function renderFiles(): void {
        const query = normalize(filter.value);
        const selectedFormat = formatFilter.value;
        const unlinked = unlinkedFiles.filter((file) => !file.track_id);
        const visible = unlinked.filter((file) => {
          if (selectedFormat && formatKey(file) !== selectedFormat)
            return false;
          if (!query) return true;
          return normalize(`${file.path} ${formatKey(file)}`).includes(query);
        });

        clear(list);
        const fragment = document.createDocumentFragment();
        for (const file of visible) fragment.append(fileRow(file));
        list.append(fragment);

        if (visible.length === 0) {
          empty.hidden = false;
          let state: HTMLElement;
          if (unlinked.length === 0) {
            state = emptyState(
              'Everything is linked',
              'Every scanned file is tied to a MusicBrainz track. New files appear here after a scan.',
              { href: '/files', label: 'Browse all files' },
            );
          } else if (query || selectedFormat) {
            state = emptyState(
              'No matching files',
              'Try a different name or format filter.',
            );
          } else {
            state = emptyState(
              'No unlinked files',
              'The scanner may still be running. Refresh in a moment.',
            );
          }
          empty.replaceChildren(state);
        } else {
          empty.hidden = true;
          empty.replaceChildren();
        }

        status.textContent =
          unlinked.length === 0
            ? 'All files are linked'
            : `${visible.length} of ${unlinked.length} unlinked files`;
      }

      async function loadFiles(): Promise<void> {
        status.textContent = 'Loading files…';
        try {
          const [filesResult, statsResult] = await Promise.allSettled([
            api.listAllUnlinkedFiles(),
            api.getFileStats(),
          ]);

          if (filesResult.status === 'rejected') throw filesResult.reason;

          unlinkedFiles = filesResult.value.items;
          fileStats =
            statsResult.status === 'fulfilled' ? statsResult.value : null;

          populateFormats();
          updateStats();
          renderFiles();

          const requested = Number(
            new URLSearchParams(location.search).get('file'),
          );
          if (Number.isInteger(requested) && requested > 0) {
            const file = unlinkedFiles.find(
              (candidate) => candidate.id === requested,
            );
            if (file && !file.track_id) {
              history.replaceState(history.state, '', '/link');
              openWizard(file);
            } else {
              const existing = await api.getFile(requested).catch(() => null);
              if (existing) {
                history.replaceState(history.state, '', '/link');
                toast('This file is already linked.', 'info');
              }
            }
          }
        } catch (error) {
          clear(list);
          empty.hidden = false;
          const message =
            error instanceof Error ? error.message : String(error);
          empty.replaceChildren(emptyState('Could not load files', message));
          status.textContent = 'Failed to load';
        }
      }

      function picker<T>(
        items: PickerItem<T>[],
        options: {
          placeholder: string;
          emptyText: string;
          isSelected: (item: T) => boolean;
          onSelect: (item: T) => void;
          autoFocus?: boolean;
        },
      ): HTMLDivElement {
        const wrap = el('div', 'picker');
        const searchWrap = el('label', 'picker__search');
        const input = el('input');
        input.type = 'search';
        input.name = 'q';
        input.placeholder = options.placeholder;
        input.setAttribute('aria-label', options.placeholder.replace(/…$/, ''));
        input.autocomplete = 'off';
        input.spellcheck = false;
        searchWrap.append(input);
        wrap.append(searchWrap);

        const listNode = el('div', 'picker__list');
        const entries: Array<{ button: HTMLButtonElement; text: string }> = [];
        const noMatch = el('div', 'picker__empty', 'No matches.');
        noMatch.hidden = true;

        for (const item of items) {
          const button = el('button', 'pick');
          button.type = 'button';
          button.setAttribute(
            'aria-pressed',
            options.isSelected(item.data) ? 'true' : 'false',
          );

          const art = el('span', 'pick__art');
          if (item.artSeed) {
            art.append(
              item.artKind === 'artist'
                ? artistAvatar(item.artSeed, item.title, '', {
                    variant: 'initials',
                  })
                : item.artKind === 'track'
                  ? trackArt(item.artSeed)
                  : discArt(item.artSeed),
            );
          } else {
            art.append(el('span', 'pick__num', item.number ?? ''));
          }

          const main = el('span', 'pick__main');
          main.append(el('span', 'pick__title', item.title));
          if (item.meta) main.append(el('span', 'pick__meta', item.meta));

          button.append(art, main, el('span', 'pick__mark', '✓'));

          button.addEventListener('click', () => {
            options.onSelect(item.data);
            for (const entry of entries) {
              entry.button.setAttribute(
                'aria-pressed',
                entry.button === button ? 'true' : 'false',
              );
            }
          });

          listNode.append(button);
          entries.push({
            button,
            text: normalize(
              `${item.title} ${item.meta ?? ''} ${item.search ?? ''}`,
            ),
          });
        }

        if (items.length === 0) {
          listNode.append(el('div', 'picker__empty', options.emptyText));
        } else {
          listNode.append(noMatch);
        }

        input.addEventListener('input', () => {
          const query = normalize(input.value);
          let visible = 0;
          for (const entry of entries) {
            const show = !query || entry.text.includes(query);
            entry.button.hidden = !show;
            if (show) visible += 1;
          }
          noMatch.hidden = visible > 0;
        });

        wrap.append(listNode);

        if (options.autoFocus !== false) {
          requestAnimationFrame(() => input.focus());
        }

        return wrap;
      }

      function canContinue(): boolean {
        const state = wizardState;
        if (!state) return false;
        if (state.step === 0) return Boolean(state.artist);
        if (state.step === 1) {
          return Boolean(state.release && state.release.tracks.length > 0);
        }
        return Boolean(state.track);
      }

      function updateFooter(): void {
        if (!wizardState) return;
        wizardNext.textContent =
          wizardState.step === 2 ? 'Link file' : 'Continue';
        wizardNext.disabled = !canContinue();
        wizardBack.disabled = wizardState.step === 0;
      }

      function updateSteps(): void {
        if (!wizardState) return;
        const steps = Array.from(wizardSteps.querySelectorAll('li'));
        steps.forEach((step, index) => {
          step.classList.toggle('is-active', index === wizardState?.step);
          step.classList.toggle('is-done', index < (wizardState?.step ?? 0));
        });
      }

      function updateTrail(): void {
        if (!wizardState) return;
        clear(wizardTrail);

        if (wizardState.artist) {
          wizardTrail.append(
            el('span', 'chip', `Artist: ${wizardState.artist.name}`),
          );
        }
        if (wizardState.group) {
          wizardTrail.append(
            el('span', 'chip', `Group: ${wizardState.group.title}`),
          );
        }
        if (wizardState.release) {
          wizardTrail.append(
            el('span', 'chip', `Release: ${wizardState.release.title}`),
          );
        }
        if (wizardState.track) {
          wizardTrail.append(
            el(
              'span',
              'chip',
              `Track: ${wizardState.track.number || wizardState.track.position} · ${wizardState.track.title}`,
            ),
          );
        }
      }

      function markChanged(): void {
        updateTrail();
        updateFooter();
      }

      function advance(): void {
        if (!wizardState || wizardState.step === 2) return;
        wizardState.step = (wizardState.step + 1) as Step;
        renderWizard();
      }

      async function renderArtistStep(token: number): Promise<void> {
        wizardBody.append(loading('Loading artists…'));
        try {
          if (!artistsCache) {
            const result = await api.listAllArtists();
            artistsCache = result.items;
          }
          if (token !== stepToken || !wizardState) return;

          clear(wizardBody);
          const state = wizardState;

          if (artistsCache.length === 0) {
            wizardBody.append(
              el(
                'div',
                'picker__empty',
                'No artists in the library yet. Add one from the Artists page first.',
              ),
            );
            return;
          }

          wizardBody.append(
            picker<Artist>(
              artistsCache.map((artist) => ({
                data: artist,
                title: artist.name,
                meta:
                  artist.disambiguation ||
                  (artist['sort-name'] && artist['sort-name'] !== artist.name
                    ? `Sort name: ${artist['sort-name']}`
                    : 'MusicBrainz artist'),
                search: artist['sort-name'] ?? '',
                artSeed: artist.id,
                artKind: 'artist',
              })),
              {
                placeholder: 'Find an artist…',
                emptyText: 'No artists match.',
                isSelected: (artist) => state.artist?.id === artist.id,
                onSelect: (artist) => {
                  state.artist = artist;
                  state.group = null;
                  state.release = null;
                  state.track = null;
                  markChanged();
                  // Selecting an artist advances immediately; Back/Continue
                  // stay available for manual navigation.
                  if (wizardState === state && state.step === 0) advance();
                },
              },
            ),
          );
        } catch (error) {
          if (token !== stepToken) return;
          clear(wizardBody);
          const message =
            error instanceof Error ? error.message : String(error);
          wizardBody.append(
            el('div', 'picker__empty', `Could not load artists: ${message}`),
          );
        }
      }

      async function renderGroupStep(token: number): Promise<void> {
        const state = wizardState;
        if (!state?.artist) return;

        wizardBody.append(loading('Loading release groups…'));
        try {
          let groups = groupsCache.get(state.artist.id);
          if (!groups) {
            const result = await api.listAllReleaseGroups({
              artist: state.artist.id,
            });
            groups = result.items;
            groupsCache.set(state.artist.id, groups);
          }
          if (token !== stepToken || !wizardState) return;

          clear(wizardBody);

          if (groups.length === 0) {
            wizardBody.append(
              el(
                'div',
                'picker__empty',
                'No release groups for this artist yet. The discography import may still be running.',
              ),
            );
            return;
          }

          wizardBody.append(
            picker<ReleaseGroup>(
              groups.map((group) => ({
                data: group,
                title: group.title,
                meta: typeLabel(group.type),
                artSeed: group.id,
                artKind: 'group',
                search: creditName(group.credit),
              })),
              {
                placeholder: 'Find a release group…',
                emptyText: 'No release groups match.',
                isSelected: (group) => state.group?.id === group.id,
                onSelect: (group) => {
                  state.group = group;
                  state.release = null;
                  state.track = null;
                  markChanged();
                  // One saved release per group: skip the release step and
                  // jump straight to its tracks.
                  void loadReleaseAndAdvance();
                },
              },
            ),
          );
        } catch (error) {
          if (token !== stepToken) return;
          clear(wizardBody);
          const message =
            error instanceof Error ? error.message : String(error);
          wizardBody.append(
            el(
              'div',
              'picker__empty',
              `Could not load release groups: ${message}`,
            ),
          );
        }
      }

      async function loadReleaseAndAdvance(): Promise<void> {
        const state = wizardState;
        if (!state?.group || state.step !== 1) return;

        const token = ++stepToken;
        clear(wizardBody);
        wizardBody.append(loading('Loading tracks…'));
        updateFooter();

        try {
          const release = await api.getReleaseByGroup(state.group.id);
          if (token !== stepToken || wizardState !== state) return;

          if (!release) {
            clear(wizardBody);
            wizardBody.append(
              el(
                'div',
                'picker__empty',
                'No release is saved for this group yet. Choose another group or wait for the discography import.',
              ),
            );
            updateFooter();
            return;
          }

          if (release.tracks.length === 0) {
            state.release = release;
            updateTrail();
            clear(wizardBody);
            wizardBody.append(
              el(
                'div',
                'picker__empty',
                'This release has no tracks saved, so there is nothing to link.',
              ),
            );
            updateFooter();
            return;
          }

          state.release = release;
          state.track = null;
          state.step = 2;
          renderWizard();
        } catch (error) {
          if (token !== stepToken || wizardState !== state) return;
          clear(wizardBody);
          const message =
            error instanceof Error ? error.message : String(error);
          wizardBody.append(
            el('div', 'picker__empty', `Could not load tracks: ${message}`),
          );
          updateFooter();
        }
      }

      function renderTrackStep(token: number): void {
        const state = wizardState;
        if (!state?.release) return;

        clear(wizardBody);
        const tracks = state.release.tracks;

        if (tracks.length === 0) {
          wizardBody.append(
            el(
              'div',
              'picker__empty',
              'This release has no tracks saved, so there is nothing to link.',
            ),
          );
          return;
        }

        wizardBody.append(
          picker<Track>(
            tracks.map((track) => ({
              data: track,
              title: track.title,
              meta: [
                `${track.disc}.${track.number || track.position}`,
                fmtDuration(track.dur_ms),
                creditName(track.credit),
              ]
                .filter(Boolean)
                .join(' · '),
              artSeed: track.id,
              artKind: 'track',
              search: creditName(track.credit),
            })),
            {
              placeholder: 'Find a track…',
              emptyText: 'No tracks match.',
              isSelected: (track) => state.track?.id === track.id,
              onSelect: (track) => {
                state.track = track;
                // Last step: select only, wait for the Link button.
                markChanged();
              },
            },
          ),
        );
        updateFooter();
        if (token !== stepToken) return;
      }

      async function renderStep(): Promise<void> {
        if (!wizardState) return;
        const token = ++stepToken;
        clear(wizardBody);
        setFormStatus(wizardStatus, '');

        if (wizardState.step === 0) await renderArtistStep(token);
        else if (wizardState.step === 1) await renderGroupStep(token);
        else renderTrackStep(token);
      }

      function renderWizard(): void {
        if (!wizardState) return;
        updateSteps();
        updateTrail();
        updateFooter();
        void renderStep();
      }

      function openWizard(file: LocalFile): void {
        wizardState = {
          file,
          step: 0,
          artist: null,
          group: null,
          release: null,
          track: null,
        };
        wizardMove.disabled = false;

        wizardFileFormat.textContent = formatKey(file);
        wizardFileName.textContent = baseName(file.path);
        wizardFilePath.textContent = dirName(file.path);

        if (!dialog.open) dialog.showModal();
        renderWizard();
      }

      async function linkSelected(): Promise<void> {
        const state = wizardState;
        if (!state?.file || !state.track) return;

        const file = state.file;
        const track = state.track;
        const move = wizardMove.checked;

        wizardNext.disabled = true;
        wizardBack.disabled = true;
        wizardMove.disabled = true;
        wizardNext.textContent = move ? 'Moving…' : 'Linking…';
        setFormStatus(
          wizardStatus,
          move
            ? 'Moving file and writing tags…'
            : 'Writing tags and linking the file…',
        );

        try {
          const response = await api.link(file.id, track.id, move);

          if (!response.ok) {
            let message = response.statusText;
            try {
              const body = await response.json();
              if (typeof body?.error === 'string' && body.error) {
                message = body.error;
              }
            } catch {
              /* keep status text */
            }
            setFormStatus(wizardStatus, message, 'error');
            wizardMove.disabled = false;
            updateFooter();
            return;
          }

          toast(
            `${baseName(file.path)} linked${move ? ' and moved' : ''} to “${track.title}”.`,
            'ok',
          );
          if (move) {
            // The rename changed the path, so reload from the server.
            await loadFiles();
          } else {
            file.track_id = track.id;
            if (fileStats) {
              fileStats.unlinked = Math.max(0, fileStats.unlinked - 1);
              fileStats.linked += 1;
            }
            populateFormats();
            updateStats();
            renderFiles();
          }
          dialog.close();
        } catch (error) {
          const message =
            error instanceof Error ? error.message : String(error);
          setFormStatus(
            wizardStatus,
            `Could not link file: ${message}`,
            'error',
          );
          wizardMove.disabled = false;
          updateFooter();
        }
      }

      byId('wizard-close').addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener('close', () => {
        wizardState = null;
        stepToken += 1;
      });

      wizardBack.addEventListener('click', () => {
        if (!wizardState || wizardState.step === 0) return;
        wizardState.step = (wizardState.step - 1) as Step;
        renderWizard();
      });

      wizardNext.addEventListener('click', () => {
        if (!wizardState) return;
        if (wizardState.step === 2) {
          void linkSelected();
          return;
        }
        advance();
      });

      filter.addEventListener('input', renderFiles);
      formatFilter.addEventListener('change', renderFiles);
      refresh.addEventListener('click', loadFiles);

      loadFiles();
    }

    document.addEventListener('astro:page-load', initLinkPage);
  </script>
</Layout>
