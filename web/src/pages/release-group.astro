---
import Layout from '../components/Layout.astro';
---

<Layout title="Release group" current="groups">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Artists</a>
    <span>/</span>
    <a href="/release-groups">Release groups</a>
    <span>/</span>
    <span id="crumb">Release group</span>
  </nav>

  <div class="notice" id="status">
    Loading release group…
  </div>

  <div id="content" hidden>
    <header class="detail-hero">
      <div class="detail-hero__art" id="hero-art"></div>
      <div class="detail-hero__body">
        <p class="eyebrow">Release group</p>
        <h1 id="title"></h1>
        <p class="credit-line" id="credit"></p>
        <p class="detail-hero__id mono" id="group-id"></p>
        <div class="detail-hero__actions" id="actions"></div>
        <dl class="stat-strip">
          <div>
            <dt>Type</dt>
            <dd id="type">—</dd>
          </div>
          <div>
            <dt>Saved release</dt>
            <dd id="saved-status">—</dd>
          </div>
          <div>
            <dt>Tracks</dt>
            <dd id="track-total">—</dd>
          </div>
        </dl>
      </div>
    </header>

    <section>
      <div class="section-head">
        <div>
          <p class="eyebrow">Catalog</p>
          <h2>Saved release</h2>
        </div>
        <span class="section-head__meta" id="release-meta"></span>
      </div>
      <div id="release-panel"></div>
    </section>

    <section id="tracks-section" hidden>
      <div class="section-head">
        <div>
          <p class="eyebrow">Tracklist</p>
          <h2>Tracks</h2>
        </div>
        <span class="section-head__meta" id="tracks-meta"></span>
      </div>
      <div id="tracks-wrap"></div>
    </section>
  </div>

  <dialog id="switch-dialog" aria-labelledby="switch-title">
    <form class="dialog__panel" id="switch-form">
      <div class="dialog__head">
        <div>
          <p class="eyebrow">Saved release</p>
          <h2 id="switch-title">Switch saved release</h2>
        </div>
        <button
          class="icon-btn"
          id="switch-close"
          type="button"
          aria-label="Close"
        >
          ×
        </button>
      </div>

      <p class="dialog__copy">
        Paste the MBID or MusicBrainz URL of another official release in this
        group. The current release and its tracks are replaced; files linked to
        the old tracks become unlinked.
      </p>

      <p class="dialog__copy mono" id="switch-current"></p>

      <label class="field">
        <span>New release MBID or MusicBrainz URL</span>
        <input
          id="switch-mbid"
          name="mbid"
          placeholder="e.g. 6a4ebc0d-… or musicbrainz.org/release/…"
          autocomplete="off"
          spellcheck="false"
          required
        />
      </label>

      <p class="form-status" id="switch-status" role="status"></p>

      <div class="dialog__actions">
        <button class="btn btn--ghost" id="switch-cancel" type="button">
          Cancel
        </button>
        <button class="btn btn--primary" id="switch-submit" type="submit">
          Switch release
        </button>
      </div>
    </form>
  </dialog>

  <script>
    import {
      api,
      extractMbid,
      fmtDuration,
      MBID_RE,
      mbUrl,
      type LinkedFile,
      type Release,
      type ReleaseGroup,
      type Track,
    } from '../lib/api';
    import { baseName, plural, typeLabel, yearOf } from '../lib/format';
    import {
      byId,
      clear,
      creditFragment,
      el,
      emptyState,
      externalLink,
      link,
      pathIs,
      setBusy,
      setFormStatus,
      setSharedArtName,
      sharedArtName,
      coverArt,
      discArt,
      toast,
    } from '../lib/ui';

    function renderFileCell(
      files: LinkedFile[] | undefined,
    ): HTMLTableCellElement {
      const cell = el('td');
      if (!files || files.length === 0) {
        cell.append(el('span', 'chip', 'No file'));
        return cell;
      }

      const first = files[0];
      const anchor = link(
        `/file?id=${first.id}`,
        baseName(first.path),
        'track-file',
      );
      anchor.title = files.map((file) => file.path).join('\n');
      cell.append(anchor);
      if (files.length > 1) {
        cell.append(el('span', 'chip', `+${files.length - 1}`));
      }
      return cell;
    }

    function renderTrack(track: Track): HTMLTableRowElement {
      const row = el('tr');

      const disc = el('td', 'num', String(track.disc));
      const number = el('td', 'num', track.number || String(track.position));

      const titleCell = el('td');
      const trackTitle = externalLink(
        mbUrl.recording(track.recording_id),
        track.title,
        'track-title',
      );
      trackTitle.title = 'Open recording on MusicBrainz';
      titleCell.append(trackTitle);

      const creditCell = el('td', 'credit-line');
      creditCell.append(creditFragment(track.credit));

      const length = el('td', 'num', fmtDuration(track.dur_ms));

      const mbCell = el('td');
      mbCell.append(
        externalLink(mbUrl.track(track.id), 'track ↗', 'track-link'),
      );

      row.append(
        disc,
        number,
        titleCell,
        creditCell,
        length,
        mbCell,
        renderFileCell(track.files),
      );
      return row;
    }

    function initReleaseGroupPage(): void {
      if (!pathIs('/release-group')) return;

      const status = byId<HTMLDivElement>('status');
      const content = byId<HTMLDivElement>('content');
      const crumb = byId<HTMLSpanElement>('crumb');
      const heroArt = byId<HTMLDivElement>('hero-art');
      const title = byId<HTMLHeadingElement>('title');
      const credit = byId<HTMLParagraphElement>('credit');
      const groupId = byId<HTMLParagraphElement>('group-id');
      const actions = byId<HTMLDivElement>('actions');
      const typeNode = byId<HTMLElement>('type');
      const savedStatus = byId<HTMLElement>('saved-status');
      const releaseMeta = byId<HTMLSpanElement>('release-meta');
      const releasePanel = byId<HTMLDivElement>('release-panel');
      const tracksSection = byId<HTMLElement>('tracks-section');
      const tracksMeta = byId<HTMLSpanElement>('tracks-meta');
      const tracksWrap = byId<HTMLDivElement>('tracks-wrap');
      const trackTotal = byId<HTMLElement>('track-total');

      const groupID = new URLSearchParams(location.search).get('id') ?? '';
      // Same-hue tile shown instantly (also feeds the shared-element morph
      // when arriving via a card); replaced with the named release on load.
      {
        const heroName = groupID ? sharedArtName('group', groupID) : null;
        if (heroName) {
          const placeholder = discArt(groupID);
          setSharedArtName(placeholder, heroName);
          byId('hero-art').replaceChildren(placeholder);
        }
      }

      const dialog = byId<HTMLDialogElement>('switch-dialog');
      const form = byId<HTMLFormElement>('switch-form');
      const mbidInput = byId<HTMLInputElement>('switch-mbid');
      const switchCurrent = byId<HTMLParagraphElement>('switch-current');
      const switchStatus = byId<HTMLParagraphElement>('switch-status');
      const switchSubmit = byId<HTMLButtonElement>('switch-submit');

      let currentGroup: ReleaseGroup | null = null;
      let switchInFlight = false;
      let coverInFlight = false;

      function openSwitch(release: Release): void {
        if (!currentGroup) return;
        form.reset();
        setFormStatus(switchStatus, '');
        switchCurrent.textContent = `Current: ${release.title} · ${release.id}`;
        dialog.showModal();
        requestAnimationFrame(() => mbidInput.focus());
      }

      function closeSwitch(): void {
        dialog.close();
      }

      async function switchRelease(newReleaseId: string): Promise<void> {
        if (!currentGroup || switchInFlight) return;
        switchInFlight = true;
        setBusy(switchSubmit, true, 'Switching…');
        setFormStatus(switchStatus, 'Fetching the release from MusicBrainz…');
        try {
          const response = await api.updateReleaseGroup(
            currentGroup.id,
            newReleaseId,
          );
          if (!response.ok) {
            let message = response.statusText;
            try {
              const body = await response.json();
              if (typeof body?.error === 'string' && body.error) {
                message = body.error;
              }
            } catch {
              /* keep status text */
            }
            setFormStatus(switchStatus, message, 'error');
            return;
          }
          toast('Saved release switched.', 'ok');
          closeSwitch();
          await load();
        } catch (error) {
          const message =
            error instanceof Error ? error.message : String(error);
          setFormStatus(
            switchStatus,
            `Could not switch release: ${message}`,
            'error',
          );
        } finally {
          switchInFlight = false;
          setBusy(switchSubmit, false);
        }
      }

      async function refreshCover(
        release: Release,
        button: HTMLButtonElement,
      ): Promise<void> {
        if (coverInFlight) return;
        coverInFlight = true;
        setBusy(button, true, 'Refreshing…');
        try {
          const row = await api.refreshReleaseCover(release.id);
          if (!row) {
            toast('No cover art found for this release.', 'info');
            return;
          }
          // The endpoint sends a 24h max-age, so bust the <img> URLs or the
          // browser would keep showing the previous bytes.
          const stamp = String(Date.now());
          for (const img of document.querySelectorAll<HTMLImageElement>(
            'img.cover-img',
          )) {
            try {
              const url = new URL(img.currentSrc || img.src, location.origin);
              url.searchParams.set('t', stamp);
              img.src = url.toString();
            } catch {
              /* keep the previous art on weird URLs */
            }
          }
          toast(`Cover refreshed (${row.source}).`, 'ok');
        } catch (error) {
          const message =
            error instanceof Error ? error.message : String(error);
          toast(`Could not refresh cover: ${message}`, 'error');
        } finally {
          coverInFlight = false;
          setBusy(button, false);
        }
      }

      async function deleteGroup(button: HTMLButtonElement): Promise<void> {
        if (!currentGroup) return;
        const groupTitle = currentGroup.title;
        const artistId = currentGroup.credit?.[0]?.artist_id;
        if (
          !window.confirm(
            `Remove "${groupTitle}" from the library? Its saved release and tracks are deleted and linked files become unlinked. Audio files are kept.`,
          )
        ) {
          return;
        }
        setBusy(button, true, 'Removing…');
        try {
          const response = await api.deleteReleaseGroup(currentGroup.id);
          if (response.status === 404) {
            toast('Release group not found.', 'error');
            return;
          }
          if (!response.ok) {
            let message = response.statusText;
            try {
              const body = await response.json();
              if (typeof body?.error === 'string' && body.error) {
                message = body.error;
              }
            } catch {
              /* keep status text */
            }
            toast(`Could not remove release group: ${message}`, 'error');
            return;
          }
          toast(`"${groupTitle}" removed.`, 'ok');
          window.location.assign(
            artistId
              ? `/artist?id=${encodeURIComponent(artistId)}`
              : '/release-groups',
          );
        } catch (error) {
          const message =
            error instanceof Error ? error.message : String(error);
          toast(`Could not remove release group: ${message}`, 'error');
        } finally {
          setBusy(button, false);
        }
      }

      function showError(message: string): void {
        status.hidden = false;
        status.classList.add('is-error');
        status.textContent = message;
        content.hidden = true;
      }

      function renderRelease(
        release: Release | null,
        group: ReleaseGroup,
      ): void {
        if (!release) {
          savedStatus.textContent = 'None';
          releaseMeta.textContent = '';
          trackTotal.textContent = '—';
          tracksSection.hidden = true;
          const firstArtist = group.credit?.[0]?.artist_id;
          releasePanel.replaceChildren(
            emptyState(
              'No release saved for this group',
              'The release group is imported, but its release has not been saved yet. The discography import may still be running.',
              firstArtist
                ? {
                    href: `/artist?id=${encodeURIComponent(firstArtist)}`,
                    label: 'Back to artist',
                  }
                : undefined,
            ),
          );
          return;
        }

        const year = yearOf(release.date);
        savedStatus.textContent = year || 'Saved';
        releaseMeta.textContent = plural(release.tracks?.length ?? 0, 'track');

        const panel = el('div', 'release-panel');
        const art = el('div', 'release-panel__art');
        art.append(coverArt('release', release.id, release.title));

        const body = el('div', 'release-panel__body');
        body.append(
          el(
            'p',
            'eyebrow',
            release.status ? typeLabel(release.status) : 'Release',
          ),
          el('h3', 'release-panel__title', release.title),
        );

        const meta = el('div', 'release-panel__meta');
        if (release.date) meta.append(el('span', '', release.date));
        meta.append(
          el('span', 'chip chip--type', typeLabel(release.group.type)),
          el('span', 'chip', plural(release.tracks?.length ?? 0, 'track')),
          el('span', 'mono', release.id),
        );
        body.append(meta);

        const panelActions = el('div', 'release-panel__actions');
        const switchButton = el(
          'button',
          'btn btn--secondary',
          'Switch release…',
        );
        switchButton.type = 'button';
        switchButton.addEventListener('click', () => openSwitch(release));
        const refreshButton = el(
          'button',
          'btn btn--secondary',
          'Refresh cover',
        );
        refreshButton.type = 'button';
        refreshButton.title =
          'Fetch the cover art again (Cover Art Archive, then Deezer)';
        refreshButton.addEventListener(
          'click',
          () => void refreshCover(release, refreshButton),
        );
        panelActions.append(
          externalLink(
            mbUrl.release(release.id),
            'MusicBrainz ↗',
            'btn btn--secondary',
          ),
          refreshButton,
          switchButton,
        );
        body.append(panelActions);

        panel.append(art, body);
        releasePanel.replaceChildren(panel);

        const tracks = release.tracks ?? [];
        const linked = tracks.filter(
          (track) => (track.files?.length ?? 0) > 0,
        ).length;
        trackTotal.textContent =
          tracks.length > 0
            ? `${linked} / ${plural(tracks.length, 'track')}`
            : '—';
        tracksMeta.textContent =
          tracks.length > 0 ? plural(tracks.length, 'track') : '';
        tracksSection.hidden = false;

        clear(tracksWrap);
        const tableWrap = el('div', 'table-wrap');
        const table = el('table', 'data-table');
        const thead = el('thead');
        const headRow = el('tr');
        for (const label of [
          'Disc',
          '#',
          'Title',
          'Artist',
          'Length',
          'MusicBrainz',
          'Local file',
        ]) {
          headRow.append(el('th', '', label));
        }
        thead.append(headRow);
        table.append(thead);
        const tbody = el('tbody');
        if (tracks.length === 0) {
          const row = el('tr');
          const cell = el('td', 'muted', 'No tracks stored for this release.');
          cell.colSpan = 7;
          row.append(cell);
          tbody.append(row);
        } else {
          const fragment = document.createDocumentFragment();
          for (const track of tracks) fragment.append(renderTrack(track));
          tbody.append(fragment);
        }
        table.append(tbody);
        tableWrap.append(table);
        tracksWrap.append(tableWrap);
      }

      async function load(): Promise<void> {
        if (!groupID) {
          showError('Missing release group id. Open one from the library.');
          return;
        }

        status.hidden = false;
        status.classList.remove('is-error');
        status.textContent = 'Loading release group…';
        content.hidden = true;

        try {
          const group = await api.getReleaseGroup(groupID);
          if (!group) {
            showError('Release group not found.');
            return;
          }
          currentGroup = group;

          const release = await api.getReleaseByGroup(group.id, true);

          document.title = `${group.title} · Coda`;
          crumb.textContent = group.title;
          const heroCover = coverArt('group', group.id, '', { eager: true });
          setSharedArtName(heroCover, sharedArtName('group', group.id));
          heroArt.replaceChildren(heroCover);
          title.textContent = group.title;
          credit.replaceChildren(creditFragment(group.credit));
          groupId.textContent = group.id;
          typeNode.textContent = typeLabel(group.type);
          actions.replaceChildren(
            externalLink(
              mbUrl.releaseGroup(group.id),
              'MusicBrainz ↗',
              'btn btn--secondary',
            ),
          );
          const deleteButton = el('button', 'btn btn--danger', 'Remove group');
          deleteButton.type = 'button';
          deleteButton.addEventListener('click', () =>
            deleteGroup(deleteButton),
          );
          actions.append(deleteButton);

          renderRelease(release, group);
          status.hidden = true;
          content.hidden = false;
        } catch (error) {
          const message =
            error instanceof Error ? error.message : String(error);
          showError(`Could not load release group: ${message}`);
        }
      }

      byId('switch-close').addEventListener('click', closeSwitch);
      byId('switch-cancel').addEventListener('click', closeSwitch);
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) closeSwitch();
      });
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const id = extractMbid(mbidInput.value);
        if (!MBID_RE.test(id)) {
          setFormStatus(
            switchStatus,
            'That doesn’t look like a release MBID or URL.',
            'error',
          );
          mbidInput.focus();
          return;
        }
        void switchRelease(id);
      });

      load();
    }

    document.addEventListener('astro:page-load', initReleaseGroupPage);
  </script>
</Layout>
