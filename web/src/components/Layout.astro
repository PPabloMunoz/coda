---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  current?: 'artists' | 'groups' | 'link' | 'files';
}

const { title, current } = Astro.props as Props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#17181a" />
    <meta
      name="description"
      content="Coda keeps a local music library linked to MusicBrainz, with tags Navidrome can read."
    />
    <ClientRouter />
    <title>{title} · Coda</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>

    <div class="shell">
      <aside class="rail">
        <a class="brand" href="/" aria-label="Coda home">
          <img
            class="brand__logo"
            src="/logo.png"
            alt=""
            width="36"
            height="36"
            aria-hidden="true"
          />
          <span class="brand__text">
            <span class="brand__word" translate="no">
              Coda
            </span>
            <span class="brand__tag">Local library</span>
          </span>
        </a>

        <nav class="rail__nav" aria-label="Main">
          <p class="rail__label">Library</p>
          <a
            class="rail__link"
            href="/"
            aria-current={current === 'artists' ? 'page' : undefined}
          >
            <svg class="rail__icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="8.25"></circle>
              <circle cx="12" cy="12" r="2.1"></circle>
            </svg>
            <span>Artists</span>
            <span class="rail__count" data-stat="artists"></span>
          </a>
          <a
            class="rail__link"
            href="/release-groups"
            aria-current={current === 'groups' ? 'page' : undefined}
          >
            <svg class="rail__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="m12 3 8.25 4.5L12 12 3.75 7.5 12 3Z"></path>
              <path d="m4.4 12 7.6 4.15L19.6 12"></path>
              <path d="m4.4 16.5 7.6 4.15 7.6-4.15"></path>
            </svg>
            <span>Release groups</span>
            <span class="rail__count" data-stat="release_groups"></span>
          </a>

          <p class="rail__label">Manage</p>
          <a
            class="rail__link"
            href="/link"
            aria-current={current === 'link' ? 'page' : undefined}
          >
            <svg class="rail__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M10.2 13.8a4.25 4.25 0 0 0 6 0l2.6-2.6a4.25 4.25 0 1 0-6-6l-1.2 1.2"></path>
              <path d="M13.8 10.2a4.25 4.25 0 0 0-6 0l-2.6 2.6a4.25 4.25 0 1 0 6 6l1.2-1.2"></path>
            </svg>
            <span>Unlinked files</span>
            <span class="rail__count" data-stat="unlinked_files"></span>
          </a>
          <a
            class="rail__link"
            href="/files"
            aria-current={current === 'files' ? 'page' : undefined}
          >
            <svg class="rail__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3.75 7.5A2.25 2.25 0 0 1 6 5.25h3l2.1 2.25H18A2.25 2.25 0 0 1 20.25 9.75v7.5A2.25 2.25 0 0 1 18 19.5H6a2.25 2.25 0 0 1-2.25-2.25v-9.75Z"></path>
            </svg>
            <span>All files</span>
            <span class="rail__count" data-stat="total_files"></span>
          </a>
        </nav>

        <div class="rail__foot">
          <span class="health" id="health" aria-live="polite">
            <span class="health__dot" aria-hidden="true"></span>
            <span class="health__label">Checking library…</span>
          </span>
          <button
            class="btn btn--secondary btn--sm"
            id="rescan"
            type="button"
            title="Rescan root folders for new or removed files"
          >
            Rescan library
          </button>
          <a
            class="rail__ext"
            href="https://musicbrainz.org"
            target="_blank"
            rel="noreferrer noopener"
          >
            MusicBrainz <span aria-hidden="true">↗</span>
          </a>
        </div>
      </aside>

      <div class="content">
        <header class="topbar" aria-label="Site">
          <div class="topbar__search" id="topbar-search">
            <label class="search">
              <input
                id="artist-search"
                name="artist-search"
                type="search"
                placeholder="Search artists…"
                autocomplete="off"
                aria-label="Search artists in your library"
                role="combobox"
                aria-expanded="false"
                aria-controls="artist-search-results"
                aria-autocomplete="list"
              />
            </label>
            <div
              class="topbar__results"
              id="artist-search-results"
              role="listbox"
              aria-label="Matching artists in your library"
              hidden
            ></div>
            <kbd class="topbar__kbd" aria-hidden="true">
              ⌘K
            </kbd>
          </div>
        </header>

        <main class="page" id="main" tabindex="-1">
          <slot />
        </main>
      </div>
    </div>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
      import { api } from '../lib/api';
      import {
        artistAvatar,
        discArt,
        setBusy,
        setSharedArtName,
        sharedArtName,
        toast,
      } from '../lib/ui';

      function setStat(key: string, value: number): void {
        const node = document.querySelector(`[data-stat="${key}"]`);
        if (node) node.textContent = value.toLocaleString();
      }

      function initLayout(): void {
        const health = document.getElementById('health');
        const healthLabel = health?.querySelector('.health__label');
        const rescan = document.getElementById('rescan');

        if (health && healthLabel) {
          fetch('/api/v1/health')
            .then((res) => {
              if (!res.ok) throw new Error('unhealthy');
              health.classList.add('is-ok');
              healthLabel.textContent = 'Library online';
            })
            .catch(() => {
              health.classList.add('is-down');
              healthLabel.textContent = 'Server unreachable';
            });
        }

        api
          .getStats()
          .then((stats) => {
            if (!stats) return;

            setStat('artists', stats.artists);
            setStat('release_groups', stats.release_groups);
            setStat('unlinked_files', stats.files.unlinked);
            setStat('total_files', stats.files.total);
          })
          .catch(() => {
            /* counts are optional */
          });

        rescan?.addEventListener('click', async () => {
          const button = rescan as HTMLButtonElement;
          setBusy(button, true, 'Scanning…');
          try {
            const response = await api.scan();
            if (!response.ok) {
              let message = response.statusText;
              try {
                message = (await response.json()).error ?? message;
              } catch {
                /* keep status text */
              }
              toast(`Could not queue scan: ${message}`, 'error');
              return;
            }
            toast('Scan queued. New files will appear shortly.', 'ok');
          } catch (error) {
            const message =
              error instanceof Error ? error.message : String(error);
            toast(`Could not queue scan: ${message}`, 'error');
          } finally {
            setBusy(button, false);
          }
        });

        initTopbarSearch();
      }

      function initTopbarSearch(): void {
        const container = document.getElementById('topbar-search');
        if (!container || container.dataset.initialized) return;
        container.dataset.initialized = 'true';

        const input = document.getElementById(
          'artist-search',
        ) as HTMLInputElement | null;
        const results = document.getElementById('artist-search-results');
        if (!input || !results) return;

        type SearchHit = { id: string; name: string };
        let items: SearchHit[] = [];
        let active = -1;
        let token = 0;
        let debounceTimer: number | undefined;

        function close(): void {
          results!.hidden = true;
          input!.setAttribute('aria-expanded', 'false');
          active = -1;
        }

        function go(hit: SearchHit): void {
          window.location.assign(`/artist?id=${encodeURIComponent(hit.id)}`);
        }

        function render(): void {
          results!.replaceChildren();
          if (items.length === 0) {
            const empty = document.createElement('div');
            empty.className = 'topbar__empty';
            empty.textContent = 'No artists found in your library.';
            results!.append(empty);
          } else {
            items.forEach((hit, index) => {
              const button = document.createElement('button');
              button.type = 'button';
              button.className =
                'topbar__result' + (index === active ? ' is-active' : '');
              button.setAttribute('role', 'option');
              button.setAttribute(
                'aria-selected',
                index === active ? 'true' : 'false',
              );
              const art = document.createElement('span');
              art.className = 'pick__art';
              art.append(
                artistAvatar(hit.id, hit.name, '', {
                  variant: 'initials',
                }),
              );
              const label = document.createElement('span');
              label.textContent = hit.name;
              button.append(art, label);
              button.addEventListener('click', () => go(hit));
              results!.append(button);
            });
          }
          results!.hidden = false;
          input!.setAttribute('aria-expanded', 'true');
        }

        async function search(query: string): Promise<void> {
          const current = ++token;
          if (query.length < 2) {
            close();
            return;
          }
          try {
            // Local library only (GET /api/v1/artists?q=) — never MusicBrainz.
            const page = await api
              .listArtists(8, 0, { query })
              .catch(() => null);
            if (current !== token) return;
            items = (page?.items ?? []).map((artist) => ({
              id: artist.id,
              name: artist.name,
            }));
            active = -1;
            render();
          } catch {
            if (current !== token) return;
            close();
          }
        }

        input.addEventListener('input', () => {
          window.clearTimeout(debounceTimer);
          const query = input.value.trim();
          // Debounced: only fires after the user pauses typing.
          debounceTimer = window.setTimeout(() => void search(query), 200);
        });

        input.addEventListener('focus', () => {
          if (items.length > 0 && input.value.trim().length >= 2) render();
        });

        const kbd = container.querySelector('.topbar__kbd');
        if (kbd) {
          kbd.textContent = /mac/i.test(navigator.platform ?? '')
            ? '⌘K'
            : 'Ctrl K';
        }

        document.addEventListener('keydown', (event) => {
          if (
            (event.metaKey || event.ctrlKey) &&
            event.key.toLowerCase() === 'k'
          ) {
            // Don't steal focus from an open dialog.
            if (document.querySelector('dialog[open]')) return;
            event.preventDefault();
            input.focus();
            input.select();
          }
        });

        input.addEventListener('keydown', (event) => {
          if (results.hidden) return;
          if (event.key === 'ArrowDown' && items.length > 0) {
            event.preventDefault();
            active = (active + 1) % items.length;
            render();
          } else if (event.key === 'ArrowUp' && items.length > 0) {
            event.preventDefault();
            active = (active - 1 + items.length) % items.length;
            render();
          } else if (event.key === 'Enter') {
            event.preventDefault();
            const pick = items[active] ?? items[0];
            if (pick) go(pick);
          } else if (event.key === 'Escape') {
            close();
            input.blur();
          }
        });

        document.addEventListener('click', (event) => {
          if (!container.contains(event.target as Node)) close();
        });
      }

      document.addEventListener('astro:page-load', initLayout);

      /**
       * Stamp the detail hero with its shared-element art before the browser
       * captures the new snapshot. `astro:after-swap` fires inside the view
       * transition update callback, so this runs in time for the morph;
       * page scripts (fetch → hero render) run after. The placeholder is a
       * same-hue tile with no label — the real art replaces it on load.
       */
      function stampHeroArt(): void {
        const path = location.pathname.replace(/\/+$/, '') || '/';
        const onArtist = path === '/artist';
        const onGroup = path === '/release-group';
        if (!onArtist && !onGroup) return;
        const id = new URLSearchParams(location.search).get('id') ?? '';
        if (!id) return;
        const name = sharedArtName(onArtist ? 'artist' : 'group', id);
        if (!name) return;
        const hero = document.getElementById('hero-art');
        if (!hero) return;
        const art = onArtist ? artistAvatar(id, '') : discArt(id);
        for (const label of art.querySelectorAll('span')) label.remove();
        setSharedArtName(art, name);
        hero.replaceChildren(art);
      }

      if (!document.documentElement.hasAttribute('data-coda-hero-transition')) {
        document.documentElement.setAttribute('data-coda-hero-transition', '');
        document.addEventListener('astro:after-swap', stampHeroArt);
      }
    </script>
  </body>
</html>
