---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout title="Release groups" current="groups">
  <PageHeader
    eyebrow="Catalog"
    title="Release groups"
    description="Every release group imported from MusicBrainz, with the release Coda has saved for it."
  >
    <button class="btn btn--secondary" id="refresh" type="button">
      Refresh
    </button>
  </PageHeader>

  <div class="toolbar">
    <label class="search">
      <input
        id="filter"
        name="q"
        type="search"
        placeholder="Filter by title or artist…"
        autocomplete="off"
        aria-label="Filter release groups by title or artist"
      />
    </label>
    <div class="legend" aria-label="Link completeness">
      <span class="legend__item">
        <span
          class="legend__dot legend__dot--complete"
          aria-hidden="true"
        ></span>
        Complete
      </span>
      <span class="legend__item">
        <span
          class="legend__dot legend__dot--partial"
          aria-hidden="true"
        ></span>
        Partial
      </span>
      <span class="legend__item">
        <span
          class="legend__dot legend__dot--missing"
          aria-hidden="true"
        ></span>
        Missing
      </span>
    </div>
    <span class="toolbar__count" id="status">
      Loading release groups…
    </span>
  </div>

  <div class="rg-grid" id="grid" aria-live="polite"></div>
  <div id="empty" hidden></div>

  <script>
    import { api, type Release, type ReleaseGroup } from '../lib/api';
    import { hydrateReleaseLine, releaseGroupCard } from '../lib/cards';
    import { plural } from '../lib/format';
    import {
      byId,
      clear,
      emptyState,
      mapLimit,
      pathIs,
      skeletonGrid,
    } from '../lib/ui';

    function initReleaseGroupsPage(): void {
      if (!pathIs('/release-groups')) return;

      const grid = byId<HTMLDivElement>('grid');
      const empty = byId<HTMLDivElement>('empty');
      const status = byId<HTMLSpanElement>('status');
      const filter = byId<HTMLInputElement>('filter');
      const refresh = byId<HTMLButtonElement>('refresh');

      const releaseCache = new Map<string, Release | null>();
      let groups: ReleaseGroup[] = [];
      let loadToken = 0;
      let searchTimer: number | undefined;

      async function hydrateCards(
        entries: Array<{ group: ReleaseGroup; line: HTMLParagraphElement }>,
      ): Promise<void> {
        await mapLimit(entries, 6, ({ group, line }) =>
          hydrateReleaseLine(line, group, releaseCache),
        );
      }

      function render(): void {
        const query = filter.value.trim();

        clear(grid);
        const fragment = document.createDocumentFragment();
        const entries: Array<{
          group: ReleaseGroup;
          line: HTMLParagraphElement;
        }> = [];

        for (const group of groups) {
          const { card, releaseLine } = releaseGroupCard(group);
          fragment.append(card);
          entries.push({ group, line: releaseLine });
        }
        grid.append(fragment);

        if (groups.length === 0) {
          empty.hidden = false;
          empty.replaceChildren(
            query
              ? emptyState(
                  'No matching release groups',
                  'Try a different title or artist.',
                )
              : emptyState(
                  'No release groups yet',
                  'Add an artist and Coda will import the discography in the background.',
                  { href: '/', label: 'Browse artists' },
                ),
          );
        } else {
          empty.hidden = true;
          empty.replaceChildren();
        }

        status.textContent = query
          ? `${groups.length} ${groups.length === 1 ? 'match' : 'matches'}`
          : plural(groups.length, 'release group');

        void hydrateCards(entries);
      }

      async function load(quiet = false): Promise<void> {
        const token = ++loadToken;
        const query = filter.value.trim();

        if (!quiet) {
          skeletonGrid(grid, 12, 'group');
          status.textContent = 'Loading release groups…';
        } else {
          status.textContent = 'Searching…';
        }

        try {
          const result = await api.listAllReleaseGroups({
            includeRelease: true,
            query,
          });
          if (token !== loadToken) return;
          groups = result.items;
          render();
        } catch (error) {
          if (token !== loadToken) return;
          clear(grid);
          empty.hidden = false;
          const message =
            error instanceof Error ? error.message : String(error);
          empty.replaceChildren(
            emptyState('Could not load release groups', message),
          );
          status.textContent = 'Failed to load';
        }
      }

      filter.addEventListener('input', () => {
        window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => void load(true), 250);
      });
      refresh.addEventListener('click', () => load());
      load();
    }

    document.addEventListener('astro:page-load', initReleaseGroupsPage);
  </script>
</Layout>
