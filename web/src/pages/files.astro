---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout title="All files" current="files">
  <PageHeader
    eyebrow="Manage"
    title="All files"
    description="Every audio file Coda has scanned from your configured roots."
  >
    <a class="btn btn--primary" href="/link">
      Link files
    </a>
  </PageHeader>

  <div class="toolbar">
    <label class="search">
      <input
        id="filter"
        name="q"
        type="search"
        placeholder="Search all files by path…"
        autocomplete="off"
        aria-label="Search all files by path"
      />
    </label>
    <label class="inline-field">
      <span>Sort</span>
      <select id="sort">
        <option value="path:asc" selected>
          Path A–Z
        </option>
        <option value="path:desc">Path Z–A</option>
        <option value="size:desc">Largest first</option>
        <option value="size:asc">Smallest first</option>
        <option value="scanned_at:desc">Recently scanned</option>
        <option value="format:asc">Format</option>
      </select>
    </label>
    <span class="toolbar__count" id="status">
      Loading files…
    </span>
    <label class="inline-field">
      <span>Per page</span>
      <select id="limit">
        <option value="25">25</option>
        <option value="50" selected>
          50
        </option>
        <option value="100">100</option>
      </select>
    </label>
  </div>

  <div class="file-list" id="list" aria-live="polite"></div>
  <div id="empty" hidden></div>

  <div class="toolbar toolbar--after">
    <button class="btn btn--secondary" id="prev" type="button">
      Previous
    </button>
    <span class="toolbar__count" id="page-info"></span>
    <button class="btn btn--secondary" id="next" type="button">
      Next
    </button>
  </div>

  <script>
    import {
      api,
      creditName,
      mbUrl,
      pageParams,
      type LocalFile,
    } from '../lib/api';
    import {
      baseName,
      dirName,
      extension,
      formatBytes,
      formatDate,
      plural,
    } from '../lib/format';
    import {
      byId,
      clear,
      el,
      emptyState,
      externalLink,
      link,
      pathIs,
      toast,
    } from '../lib/ui';

    function initFilesPage(): void {
      if (!pathIs('/files')) return;

      const list = byId<HTMLDivElement>('list');
      const empty = byId<HTMLDivElement>('empty');
      const status = byId<HTMLSpanElement>('status');
      const pageInfo = byId<HTMLSpanElement>('page-info');
      const filter = byId<HTMLInputElement>('filter');
      const sortSelect = byId<HTMLSelectElement>('sort');
      const limitSelect = byId<HTMLSelectElement>('limit');
      const prev = byId<HTMLButtonElement>('prev');
      const next = byId<HTMLButtonElement>('next');

      const initial = pageParams(50);
      let limit = initial.limit;
      let offset = initial.offset;
      let total = 0;
      let files: LocalFile[] = [];
      let loadToken = 0;
      let searchTimer: number | undefined;
      limitSelect.value = String(limit);

      function fileRow(file: LocalFile): HTMLElement {
        const row = el('article', 'file-row');

        const format = el(
          'div',
          'file-row__format',
          (file.format_hint || extension(file.path)).toUpperCase(),
        );

        const main = el('div', 'file-row__main');
        main.append(
          el('h3', 'file-row__name', baseName(file.path)),
          el('p', 'file-row__path', dirName(file.path)),
        );

        if (file.track) {
          const trackLine = el('p', 'file-row__track');
          trackLine.append(
            document.createTextNode('Linked to '),
            link(
              `/release-group?id=${encodeURIComponent(file.track.group.id)}`,
              file.track.title,
            ),
          );
          const artist = creditName(file.track.credit);
          if (artist) trackLine.append(document.createTextNode(` — ${artist}`));
          main.append(trackLine);
        }

        const meta = el('div', 'file-row__meta');
        meta.append(
          el('span', '', formatBytes(file.size_bytes)),
          el('span', '', `Scanned ${formatDate(file.scanned_at)}`),
        );
        if (file.track_id) {
          meta.append(el('span', 'chip chip--ok', 'Linked'));
        } else {
          meta.append(el('span', 'chip chip--warn', 'Unlinked'));
        }
        main.append(meta);

        const actions = el('div', 'file-row__actions');
        actions.append(link(`/file?id=${file.id}`, 'Details', 'btn btn--sm'));

        if (file.track_id) {
          actions.append(
            externalLink(
              mbUrl.track(file.track_id),
              'Track ↗',
              'btn btn--sm btn--ghost',
            ),
          );
          const refresh = el('button', 'btn btn--sm btn--secondary', 'Refresh');
          refresh.type = 'button';
          refresh.title = 'Rewrite tags from the linked track';
          refresh.addEventListener('click', () => refreshFile(file, refresh));
          actions.append(refresh);
          const unlink = el('button', 'btn btn--sm btn--danger', 'Unlink');
          unlink.type = 'button';
          unlink.addEventListener('click', () => unlinkFile(file, unlink));
          actions.append(unlink);
        } else {
          actions.append(
            link(
              `/link?file=${file.id}`,
              'Link to track',
              'btn btn--sm btn--primary',
            ),
          );
        }

        row.append(format, main, actions);
        return row;
      }

      function render(): void {
        const query = filter.value.trim();

        clear(list);
        const fragment = document.createDocumentFragment();
        for (const file of files) fragment.append(fileRow(file));
        list.append(fragment);

        if (files.length === 0) {
          empty.hidden = false;
          let state: HTMLElement;
          if (query) {
            state = emptyState(
              'No matching files',
              'Try a different path or clear the search.',
            );
          } else if (total === 0 && offset === 0) {
            state = emptyState(
              'No files scanned yet',
              'Add a root folder in config.yaml and restart Coda. Files appear here after a scan.',
            );
          } else {
            state = emptyState(
              'No files on this page',
              'The library changed since this page was loaded.',
              { href: '/files', label: 'Start over' },
            );
          }
          empty.replaceChildren(state);
        } else {
          empty.hidden = true;
          empty.replaceChildren();
        }

        if (total > 0) {
          const end = offset + files.length;
          status.textContent = `Showing ${offset + 1}–${end} of ${plural(total, 'file')}`;
          pageInfo.textContent = `Page ${Math.floor(offset / limit) + 1}`;
        } else {
          status.textContent = query ? '0 matches' : '0 files';
          pageInfo.textContent = '';
        }

        prev.disabled = offset <= 0;
        next.disabled = offset + limit >= total;
      }

      async function unlinkFile(
        file: LocalFile,
        button: HTMLButtonElement,
      ): Promise<void> {
        const name = baseName(file.path);
        const confirmed = window.confirm(
          `Remove the MusicBrainz link and clear tags from “${name}”?`,
        );
        if (!confirmed) return;

        button.disabled = true;
        button.textContent = 'Unlinking…';
        try {
          const response = await api.unlink(file.id);
          if (!response.ok) {
            let message = response.statusText;
            try {
              message = (await response.json()).error ?? message;
            } catch {
              /* keep status text */
            }
            toast(`Could not unlink: ${message}`, 'error');
            return;
          }
          toast(`${name} unlinked.`, 'ok');
          await load();
        } catch (error) {
          const message =
            error instanceof Error ? error.message : String(error);
          toast(`Could not unlink: ${message}`, 'error');
        } finally {
          button.disabled = false;
          button.textContent = 'Unlink';
        }
      }

      async function refreshFile(
        file: LocalFile,
        button: HTMLButtonElement,
      ): Promise<void> {
        const name = baseName(file.path);

        button.disabled = true;
        button.textContent = 'Refreshing…';
        try {
          const response = await api.refreshFile(file.id);
          if (!response.ok) {
            let message = response.statusText;
            try {
              message = (await response.json()).error ?? message;
            } catch {
              /* keep status text */
            }
            toast(`Could not refresh tags: ${message}`, 'error');
            return;
          }
          toast(`Tags refreshed for ${name}.`, 'ok');
          await load();
        } catch (error) {
          const message =
            error instanceof Error ? error.message : String(error);
          toast(`Could not refresh tags: ${message}`, 'error');
        } finally {
          button.disabled = false;
          button.textContent = 'Refresh';
        }
      }

      async function load(): Promise<void> {
        const token = ++loadToken;
        const [sortField, sortOrder] = sortSelect.value.split(':');

        prev.disabled = true;
        next.disabled = true;
        status.textContent = 'Loading files…';

        try {
          const page = await api.listFiles(limit, offset, {
            includeTrack: true,
            query: filter.value.trim(),
            sort: sortField,
            order: sortOrder,
          });
          if (token !== loadToken) return;

          files = page?.items ?? [];
          total = page?.total ?? 0;

          if (files.length === 0 && offset > 0) {
            offset = Math.max(0, offset - limit);
            await load();
            return;
          }

          render();
          history.replaceState(
            history.state,
            '',
            `?limit=${limit}&offset=${offset}`,
          );
        } catch (error) {
          if (token !== loadToken) return;
          clear(list);
          empty.hidden = false;
          const message =
            error instanceof Error ? error.message : String(error);
          empty.replaceChildren(emptyState('Could not load files', message));
          status.textContent = 'Failed to load';
        }
      }

      filter.addEventListener('input', () => {
        window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => {
          offset = 0;
          void load();
        }, 250);
      });
      sortSelect.addEventListener('change', () => {
        offset = 0;
        void load();
      });
      limitSelect.addEventListener('change', () => {
        limit = Number(limitSelect.value) || 50;
        offset = 0;
        void load();
      });
      prev.addEventListener('click', () => {
        offset = Math.max(0, offset - limit);
        void load();
      });
      next.addEventListener('click', () => {
        offset += limit;
        void load();
      });

      load();
    }

    document.addEventListener('astro:page-load', initFilesPage);
  </script>
</Layout>
